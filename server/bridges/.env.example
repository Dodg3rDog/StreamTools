# Picarto bot account
PICARTO_BOT_USERNAME=
PICARTO_OAUTH_TOKEN=

# Streamer.bot HTTP server
STREAMERBOT_HTTP_URL=http://127.0.0.1:7474
STREAMERBOT_PICARTO_ACTION_NAME=Picarto Chat Message

# Bridge behavior
PICARTO_COMMAND_PREFIX=!
PICARTO_FORWARD_ALL=true
PICARTO_ENABLE_PING_REPLY=true
PICARTO_BRIDGE_DEBUG=false
